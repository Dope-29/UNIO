generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  CLOSED
}

enum InvStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCT
  SUBSCRIPTION
}

enum PayMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  ONLINE
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String
  name           String
  role           Role
  isActive       Boolean              @default(true)
  sessionVersion Int                  @default(0)
  customer       Customer?
  resetTokens    PasswordResetToken[]
  payments       Payment[]
  reminders      ReminderLog[]
  createdAt      DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, usedAt])
  @@index([expiresAt])
}

model Customer {
  id            String         @id @default(cuid())
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: Restrict)
  name          String
  email         String         @unique
  company       String?
  phone         String?
  address       String?
  subscriptions Subscription[]
  invoices      Invoice[]
}

model Product {
  id                String                  @id @default(cuid())
  name              String
  type              String
  salesPrice        Decimal                 @db.Decimal(12, 2)
  costPrice         Decimal                 @db.Decimal(12, 2)
  notes             String?
  isActive          Boolean                 @default(true)
  variants          ProductVariant[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
}

model ProductVariant {
  id                String                  @id @default(cuid())
  productId         String
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  attribute         String
  value             String
  extraPrice        Decimal                 @db.Decimal(12, 2)
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@unique([productId, attribute, value])
}

model Plan {
  id              String              @id @default(cuid())
  name            String
  price           Decimal             @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  minQuantity     Int                 @default(1)
  availableFrom   DateTime
  availableTo     DateTime?
  autoCloseOnEnd  Boolean             @default(false)
  allowEarlyClose Boolean             @default(false)
  allowPause      Boolean             @default(false)
  allowRenew      Boolean             @default(false)
  isActive        Boolean             @default(true)
  subscriptions   Subscription[]
  templates       QuotationTemplate[]
}

model QuotationTemplate {
  id           String                  @id @default(cuid())
  name         String
  validityDays Int
  planId       String
  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines        QuotationTemplateLine[]

  @@index([planId])
}

model QuotationTemplateLine {
  id         String            @id @default(cuid())
  templateId String
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId  String?
  variant    ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity   Int
  taxId      String?
  tax        Tax?              @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@index([templateId])
}

model Tax {
  id                String                  @id @default(cuid())
  name              String
  ratePercent       Decimal                 @db.Decimal(5, 2)
  isActive          Boolean                 @default(true)
  subscriptionLines SubscriptionLine[]
  templateLines     QuotationTemplateLine[]
}

model Discount {
  id          String            @id @default(cuid())
  name        String
  type        DiscountType
  value       Decimal           @db.Decimal(12, 2)
  minPurchase Decimal?          @db.Decimal(12, 2)
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int
  usedCount   Int               @default(0)
  scope       DiscountScope
  productIds  String[]
  isActive    Boolean           @default(true)
  invoices    InvoiceDiscount[]

  @@index([isActive, startDate, endDate])
}

model Subscription {
  id                  String             @id @default(cuid())
  number              String             @unique
  customerId          String
  customer            Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate           DateTime
  expiryDate          DateTime
  billingAnchorDay    Int
  validityDays        Int
  dueDays             Int                @default(0)
  paymentTerms        String
  status              SubStatus          @default(DRAFT)
  nextBillingDate     DateTime?
  pausedAt            DateTime?
  quotationValidUntil DateTime?
  lines               SubscriptionLine[]
  invoices            Invoice[]

  @@index([status, nextBillingDate])
  @@index([customerId])
  @@index([planId])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)
  taxId          String?
  tax            Tax?            @relation(fields: [taxId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
}

model Invoice {
  id              String            @id @default(cuid())
  number          String            @unique
  subscriptionId  String
  subscription    Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName    String
  customerEmail   String
  customerAddress String?
  currency        String
  periodStart     DateTime
  periodEnd       DateTime
  issueDate       DateTime
  dueDate         DateTime
  status          InvStatus         @default(DRAFT)
  subtotal        Decimal           @db.Decimal(12, 2)
  discountTotal   Decimal           @db.Decimal(12, 2)
  taxTotal        Decimal           @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  amountPaid      Decimal           @default(0) @db.Decimal(12, 2)
  sentAt          DateTime?
  lines           InvoiceLine[]
  payments        Payment[]
  discounts       InvoiceDiscount[]
  reminders       ReminderLog[]
  gatewayOrders   GatewayOrder[]

  @@unique([subscriptionId, periodStart])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([issueDate])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  description    String
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

model InvoiceDiscount {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  discountId String
  discount   Discount @relation(fields: [discountId], references: [id], onDelete: Restrict)
  amount     Decimal  @db.Decimal(12, 2)

  @@unique([invoiceId, discountId])
  @@index([discountId])
}

model Payment {
  id           String    @id @default(cuid())
  invoiceId    String
  invoice      Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  method       PayMethod
  amount       Decimal   @db.Decimal(12, 2)
  paidAt       DateTime
  note         String?
  gatewayRef   String?   @unique
  recordedById String?
  recordedBy   User?     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paidAt])
}

model ReminderLog {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  sentAt    DateTime @default(now())
  sentById  String?
  sentBy    User?    @relation(fields: [sentById], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model Counter {
  key   String @id
  value Int    @default(0)
}

model MailOutbox {
  id            String    @id @default(cuid())
  to            String
  subject       String
  text          String
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  nextAttemptAt DateTime  @default(now())
  attempts      Int       @default(0)

  @@index([sentAt, nextAttemptAt])
}

model GatewayOrder {
  id        String    @id
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Decimal   @db.Decimal(12, 2)
  currency  String
  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([invoiceId])
}
