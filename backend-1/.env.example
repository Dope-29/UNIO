NODE_ENV=development
PORT=4000
# Supabase Dashboard -> Connect. Use the Session pooler URI for runtime and the direct URI for setup.
# Do not use the Supabase project URL, anon key, or service-role key here.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_KEY=replace-with-another-random-secret
FRONTEND_URL=http://localhost:5173
CURRENCY=INR
# Stacked percentages are calculated from each line's original subtotal.
DISCOUNT_PERCENT_BASE=ORIGINAL
COOKIE_SAME_SITE=lax
CRON_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@example.com>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
