NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/brightloop
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_KEY=replace-with-another-random-secret
FRONTEND_URL=http://localhost:5173
CURRENCY=INR
# Stacked percentages are calculated from each line's original subtotal.
DISCOUNT_PERCENT_BASE=ORIGINAL
COOKIE_SAME_SITE=lax
CRON_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Brightloop <billing@example.com>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
